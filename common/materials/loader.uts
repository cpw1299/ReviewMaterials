// Web 端读取合并后的轻量兼容 JSON；App 端读取按大章节拆分的静态资源。
// #ifdef WEB
import indexRaw from './index.json'
import mechanicalRaw from './mechanical-drawing.json'
import caidRaw from './caid.json'
import industrialRaw from './industrial-design-history.json'
import productRaw from './product-design.json'
// #endif

import { MaterialIndex, Material, MaterialSection, ContentBlock, MaterialManifest } from './types.uts'

let cachedIndex : MaterialIndex | null = null
const materialCache = new Map<string, Material>()
const blockIndexCache = new Map<string, Map<string, ContentBlock>>()
const sectionOfBlockCache = new Map<string, Map<string, string>>()
const readableCache = new Map<string, MaterialSection[]>()

// #ifdef APP
function readStaticJson(path : string) : string {
	const fs = uni.getFileSystemManager()
	return fs.readFileSync(path, 'utf-8') as string
}

function parseStaticJson<T>(path : string) : T {
	const parsed = JSON.parse<T>(readStaticJson(path))
	if (parsed == null) throw new Error('资料 JSON 解析失败: ' + path)
	return parsed!
}

function loadSplitMaterial(id : string) : Material | null {
	const manifest = parseStaticJson<MaterialManifest>('/static/materials/parts/' + id + '/manifest.json')
	const sections : MaterialSection[] = []
	const blocks : ContentBlock[] = []
	for (let i = 0; i < manifest.chapters.length; i++) {
		const part = parseStaticJson<Material>('/static/materials/parts/' + id + '/' + manifest.chapters[i].file)
		for (let j = 0; j < part.sections.length; j++) sections.push(part.sections[j])
		for (let j = 0; j < part.blocks.length; j++) blocks.push(part.blocks[j])
	}
	return { schemaVersion: manifest.schemaVersion, id: manifest.id, title: manifest.title, subject: manifest.subject, sections, blocks }
}
// #endif

function parseImportedJson<T>(raw : any) : T {
	const text = JSON.stringify(raw)
	if (text == null) throw new Error('资料 JSON 序列化失败')
	const parsed = JSON.parse<T>(text!)
	if (parsed == null) throw new Error('资料 JSON 类型转换失败')
	return parsed!
}

export function loadMaterialIndex() : MaterialIndex {
	if (cachedIndex == null) {
		// #ifdef APP
		cachedIndex = parseStaticJson<MaterialIndex>('/static/materials/index.json')
		// #endif
		// #ifdef WEB
		cachedIndex = parseImportedJson<MaterialIndex>(indexRaw)
		// #endif
	}
	return cachedIndex!
}

export function loadMaterial(id : string) : Material | null {
	const hit = materialCache.get(id)
	if (hit != null) return hit
	let material : Material | null = null

	// #ifdef APP
	if (id == 'mechanical-drawing' || id == 'caid' || id == 'industrial-design-history' || id == 'product-design') {
		material = loadSplitMaterial(id)
	}
	// #endif

	// #ifdef WEB
	if (id == 'mechanical-drawing') material = parseImportedJson<Material>(mechanicalRaw)
	else if (id == 'caid') material = parseImportedJson<Material>(caidRaw)
	else if (id == 'industrial-design-history') material = parseImportedJson<Material>(industrialRaw)
	else if (id == 'product-design') material = parseImportedJson<Material>(productRaw)
	// #endif

	if (material == null) return null
	materialCache.set(id, material!)
	return material
}

export function chapters(material : Material) : MaterialSection[] {
	const result : MaterialSection[] = []
	for (let i = 0; i < material.sections.length; i++) if (material.sections[i].level == 1) result.push(material.sections[i])
	return result
}

function blockIndex(material : Material) : Map<string, ContentBlock> {
	let idx = blockIndexCache.get(material.id)
	if (idx == null) {
		idx = new Map<string, ContentBlock>()
		for (let i = 0; i < material.blocks.length; i++) idx.set(material.blocks[i].id, material.blocks[i])
		blockIndexCache.set(material.id, idx)
	}
	return blockIndexCache.get(material.id)!
}

export function isReadable(material : Material, section : MaterialSection) : boolean {
	const idx = blockIndex(material)
	for (let i = 0; i < section.blockIds.length; i++) {
		const b = idx.get(section.blockIds[i])
		if (b != null && b!.type != 'heading') return true
	}
	return false
}

export function readableSections(material : Material) : MaterialSection[] {
	const hit = readableCache.get(material.id)
	if (hit != null) return hit
	const result : MaterialSection[] = []
	for (let i = 0; i < material.sections.length; i++) if (isReadable(material, material.sections[i])) result.push(material.sections[i])
	readableCache.set(material.id, result)
	return result
}

export function childrenOf(material : Material, parentId : string) : MaterialSection[] {
	const result : MaterialSection[] = []
	for (let i = 0; i < material.sections.length; i++) {
		const s = material.sections[i]
		if (s.level == 2 && s.parentId == parentId) result.push(s)
	}
	return result
}

export function sectionById(material : Material, id : string) : MaterialSection | null {
	for (let i = 0; i < material.sections.length; i++) if (material.sections[i].id == id) return material.sections[i]
	return null
}

export function chapterOf(material : Material, section : MaterialSection) : MaterialSection | null {
	if (section.parentId == null) return section
	return sectionById(material, section.parentId!)
}

export function blocksOf(material : Material, section : MaterialSection) : ContentBlock[] {
	const idx = blockIndex(material); const result : ContentBlock[] = []
	for (let i = 0; i < section.blockIds.length; i++) {
		const b = idx.get(section.blockIds[i]); if (b != null) result.push(b!)
	}
	return result
}

function sectionOfBlock(material : Material) : Map<string, string> {
	let idx = sectionOfBlockCache.get(material.id)
	if (idx == null) {
		idx = new Map<string, string>()
		for (let i = 0; i < material.sections.length; i++) for (let j = 0; j < material.sections[i].blockIds.length; j++) idx.set(material.sections[i].blockIds[j], material.sections[i].id)
		sectionOfBlockCache.set(material.id, idx)
	}
	return sectionOfBlockCache.get(material.id)!
}

export function sectionOfBlockId(material : Material, blockId : string) : MaterialSection | null {
	const sid = sectionOfBlock(material).get(blockId)
	if (sid == null) return null
	return sectionById(material, sid)
}

export function prevSection(material : Material, sectionId : string) : MaterialSection | null {
	const list = readableSections(material)
	for (let i = 1; i < list.length; i++) if (list[i].id == sectionId) return list[i - 1]
	return null
}

export function nextSection(material : Material, sectionId : string) : MaterialSection | null {
	const list = readableSections(material)
	for (let i = 0; i < list.length - 1; i++) if (list[i].id == sectionId) return list[i + 1]
	return null
}

export function sectionPosition(material : Material, sectionId : string) : string {
	const list = readableSections(material)
	for (let i = 0; i < list.length; i++) if (list[i].id == sectionId) return (i + 1).toString() + ' / ' + list.length.toString()
	return ''
}
