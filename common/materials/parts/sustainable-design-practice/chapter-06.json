        [
          ""
        ]
      ],
      "depth": 0
    },
    {
      "id": "blk-0407",
      "type": "paragraph",
      "level": 0,
      "text": "第一条 让消费者了解食物的环境成本，做出知情选择。",
      "label": "",
      "marker": "",
      "ordered": false,
      "headers": [
        ""
      ],
      "rows": [
        [
          ""
        ]
      ],
      "depth": 0
    },
    {
      "id": "blk-0408",
      "type": "paragraph",
      "level": 0,
      "text": "第二条 引导消费者选择低碳饮食，减少碳排放。",
