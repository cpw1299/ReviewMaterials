      "marker": "",
      "ordered": false,
      "headers": [
        ""
      ],
      "rows": [
        [
          ""
        ]
      ],
      "depth": 0
    },
    {
      "id": "blk-0411",
      "type": "paragraph",
      "level": 0,
      "text": "第五条 用信息透明推动可持续消费。",
