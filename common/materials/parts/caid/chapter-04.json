    {
      "id": "blk-0122",
      "type": "table",
      "level": 0,
      "text": "",
      "label": "",
      "marker": "",
      "ordered": false,
      "headers": [
        "选项卡",
        "管理内容"
      ],
      "rows": [
        [
          "场景",
          "模型本身 + 环境背景"
        ],
        [
          "材质",
          "给模型赋什么材料"
        ],
        [
          "环境",
          "灯光怎么打、HDR环境图"
        ],
