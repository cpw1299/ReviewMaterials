    {
      "id": "blk-0100",
      "type": "table",
      "level": 0,
      "text": "",
      "label": "",
      "marker": "",
      "ordered": false,
      "headers": [
        "工具",
        "检测维度",
        "合格判定标准"
      ],
      "rows": [
        [
          "曲率梳",
          "曲线的平滑度",
          "梳齿均匀顺滑，没有突变"
        ],
        [
          "斑马纹分析",
          "曲面的连续性",
          "条纹顺滑连续，没有断开或错位"
        ]
      ],
      "depth": 0
