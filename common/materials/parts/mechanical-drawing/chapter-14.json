      "text": "",
      "label": "",
      "marker": "",
      "ordered": false,
      "headers": [
        "错误类型",
        "避免方法"
      ],
      "rows": [
        [
          "投影关系错误",
          "牢记\"长对正、高平齐、宽相等\""
        ],
        [
          "线型混淆",
          "粗实线0.7mm，细实线0.25mm"
        ],
        [
          "剖视中虚线滥用",
          "剖视后虚线一般不画"
        ],
        [
          "尺寸标注重复遗漏",
          "先分析定形、定位尺寸，避免封闭尺寸链"
        ],
        [
          "螺纹画法错误",
          "记住口诀\"外大粗内小细，内小粗大细\""
        ],
        [
          "三视图方位混乱",
          "俯视图前边在下，后边在上"
        ]
      ],
      "depth": 0
    }
