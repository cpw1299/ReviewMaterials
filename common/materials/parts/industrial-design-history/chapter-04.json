      "marker": "",
      "ordered": false,
      "headers": [
        ""
      ],
      "rows": [
        [
          ""
        ]
      ],
      "depth": 0
    },
    {
      "id": "blk-0118",
      "type": "paragraph",
      "level": 0,
      "text": "设计必须为制造而设计（极简结构、标准化零件）",
