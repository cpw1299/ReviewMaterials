export type MaterialIndexItem = {
	id : string
	title : string
	subject : string
	file : string
	sectionCount : number
	blockCount : number
	updatedAt : string
}

export type MaterialIndex = {
	schemaVersion : number
	materials : MaterialIndexItem[]
}

export type MaterialSection = {
	id : string
	title : string
	level : number
	parentId : string | null
	blockIds : string[]
}

/**
 * 所有 block 形状统一（缺省字段也给默认值），保证 JSON 可以整体 as ContentBlock[] 转型。
 * type 取值：heading / paragraph / kv / list_item / table / quote
 */
export type ContentBlock = {
	id : string
	type : string
	level : number
	text : string
	label : string
	marker : string
	ordered : boolean
	headers : string[]
	rows : string[][]
	depth : number
}

export type Material = {
	schemaVersion : number
	id : string
	title : string
	subject : string
	sections : MaterialSection[]
	blocks : ContentBlock[]
}
