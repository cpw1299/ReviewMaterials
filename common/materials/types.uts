export type MaterialIndexItem = {
	id : string
	title : string
	subject : string
	file : string
	sectionCount : number
	blockCount : number
	updatedAt : string
}

export type MaterialIndex = {
	schemaVersion : number
	materials : MaterialIndexItem[]
}

export type MaterialSection = {
	id : string
	title : string
	level : number
	parentId : string | null
	blockIds : string[]
}

export type ContentBlock = {
	id : string
	type : string
	level : number
	text : string
	label : string
	marker : string
	ordered : boolean
	headers : string[]
	rows : string[][]
	depth : number
}

export type Material = {
	schemaVersion : number
	id : string
	title : string
	subject : string
	sections : MaterialSection[]
	blocks : ContentBlock[]
}

export type MaterialChapterManifestItem = {
	id : string
	title : string
	file : string
	sectionCount : number
	blockCount : number
}

export type MaterialManifest = {
	schemaVersion : number
	id : string
	title : string
	subject : string
	chapters : MaterialChapterManifestItem[]
}
