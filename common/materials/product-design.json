 "blocks": [
  {
   "id": "blk-001",
   "type": "heading",
   "level": 1,
   "text": "第一章 产品设计与设计学",
   "label": "",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-002",
   "type": "paragraph",
   "level": 0,
   "text": "【考情分析】本章每年分值16—20分，题型覆盖选择题、填空题、简答题。",
   "label": "",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-003",
   "type": "heading",
   "level": 2,
   "text": "核心考点一：产品设计史四大运动（★★★★★）",
   "label": "",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-004",
   "type": "list_item",
   "level": 0,
   "text": "艺术与手工艺运动（19世纪下半叶）",
   "label": "",
   "marker": "1.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-005",
   "type": "kv",
   "level": 0,
   "text": "约翰·拉斯金（理论先驱）、威廉·莫里斯（实践领袖）",
   "label": "代表人物",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-006",
   "type": "kv",
   "level": 0,
   "text": "“诚实设计”——忠实于材料、结构、功能；反对机器粗制滥造；推崇中世纪手工艺",
   "label": "核心理念",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-007",
   "type": "kv",
   "level": 0,
   "text": "红屋（莫里斯）、莫里斯商行壁纸",
   "label": "代表作",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-008",
   "type": "kv",
   "level": 0,
   "text": "确立设计伦理；提升手工艺地位；启发后世设计运动",
   "label": "历史贡献",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-009",
   "type": "kv",
   "level": 0,
   "text": "反工业化，产品昂贵，未能实现“为大众设计”的理想",
   "label": "根本局限",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-010",
   "type": "list_item",
   "level": 0,
   "text": "现代主义设计（20世纪初）",
   "label": "",
   "marker": "2.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-011",
   "type": "kv",
   "level": 0,
   "text": "“形式追随功能”（路易斯·沙利文）；功能主义、理性主义、标准化；“少即是多”（密斯·凡·德·罗）",
   "label": "核心理念",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-012",
   "type": "kv",
   "level": 0,
   "text": "德意志制造联盟（彼得·贝伦斯）、荷兰风格派（里特维尔德）、俄国构成主义（塔特林）",
   "label": "代表流派",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-013",
   "type": "kv",
   "level": 0,
   "text": "奠定了现代设计的功能基石；使设计适应工业化生产",
   "label": "历史贡献",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-014",
   "type": "kv",
   "level": 0,
   "text": "被教条化为国际主义风格，冷漠缺乏人情味",
   "label": "后期批判",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-015",
   "type": "list_item",
   "level": 0,
   "text": "包豪斯（1919—1933）",
   "label": "",
   "marker": "3.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-016",
   "type": "kv",
   "level": 0,
   "text": "“艺术与技术的新统一”",
   "label": "核心理念",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-017",
   "type": "kv",
   "level": 0,
   "text": "双轨制教学（形式大师+技术大师）、基础课（三大构成）、工作室制",
   "label": "教育体系",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-018",
   "type": "kv",
   "level": 0,
   "text": "魏玛（表现主义）、德绍（理性主义，黄金时代）、柏林（密斯）",
   "label": "三阶段",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-019",
   "type": "kv",
   "level": 0,
   "text": "德绍校舍（格罗皮乌斯）、瓦西里椅（布劳耶）、MT8台灯（布兰特）",
   "label": "代表作品",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-020",
   "type": "kv",
   "level": 0,
   "text": "现代设计教育奠基；培养跨学科设计师；传播功能主义",
   "label": "历史贡献",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-021",
   "type": "list_item",
   "level": 0,
   "text": "乌尔姆设计学院（1953—1968）",
   "label": "",
   "marker": "4.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-022",
   "type": "kv",
   "level": 0,
   "text": "设计是一门科学，强调系统性、方法论、跨学科",
   "label": "核心理念",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-023",
   "type": "kv",
   "level": 0,
   "text": "从艺术导向转向科学导向，引入社会学、符号学、人机工程学",
   "label": "与包豪斯决裂",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-024",
   "type": "kv",
   "level": 0,
   "text": "形成“乌尔姆—布劳恩体系”，代表产品SK4收音留声机",
   "label": "与博朗合作",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-025",
   "type": "kv",
   "level": 0,
   "text": "推动设计程序与方法论的系统化；奠定德国理性设计风格",
   "label": "历史贡献",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-026",
   "type": "heading",
   "level": 2,
   "text": "核心考点二：设计与产品设计的核心概念（★★★★★）",
   "label": "",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-027",
   "type": "list_item",
   "level": 0,
   "text": "设计的本质：有目的地解决问题，在多重约束下创造性地满足需求",
   "label": "",
   "marker": "1.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-028",
   "type": "list_item",
   "level": 0,
   "text": "设计与艺术的区别：艺术重自我表达，设计重问题解决；艺术评价主观，设计评价综合（功能、可用性、商业等）",
   "label": "",
   "marker": "2.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-029",
   "type": "list_item",
   "level": 0,
   "text": "设计与工程的区别：工程关注“如何实现”，设计关注“为什么需要”和“如何更好用”",
   "label": "",
   "marker": "3.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-030",
   "type": "list_item",
   "level": 0,
   "text": "产品设计的概念：针对批量化生产的工业产品，综合运用技术、艺术、经济等知识进行系统规划",
   "label": "",
   "marker": "4.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-031",
   "type": "list_item",
   "level": 0,
   "text": "产品设计的六大要素：功能、形态、用户体验、技术与工程、商业与市场、社会与环境",
   "label": "",
   "marker": "5.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-032",
   "type": "list_item",
   "level": 0,
   "text": "当代产品设计趋势：从“物”到“事”（重服务体验）、软硬结合（智能互联）、可持续性成为核心",
   "label": "",
   "marker": "6.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-033",
   "type": "heading",
   "level": 2,
   "text": "核心考点三：程序、方法、基础三者的关系（★★★★★）",
   "label": "",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-034",
   "type": "list_item",
   "level": 0,
   "text": "设计程序：宏观战略框架，回答“项目总体上如何推进”（如双钻模型）",
   "label": "",
   "marker": "1.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-035",
   "type": "list_item",
   "level": 0,
   "text": "设计方法：微观战术工具，回答“在某个阶段具体怎么做”（如用户访谈、头脑风暴）",
   "label": "",
   "marker": "2.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-036",
   "type": "list_item",
   "level": 0,
   "text": "设计基础：设计师内功素养，回答“需要哪些知识和技能”（如造型美学、工程知识）",
   "label": "",
   "marker": "3.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-037",
   "type": "list_item",
   "level": 0,
   "text": "关系比喻：程序是地图，方法是交通工具，基础是驾驶技能和体能",
   "label": "",
   "marker": "4.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-038",
   "type": "list_item",
   "level": 0,
   "text": "三者协同：程序统领方法，方法依赖基础，基础通过方法在程序中实现价值，并循环迭代进化",
   "label": "",
   "marker": "5.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-039",
   "type": "kv",
   "level": 0,
   "text": "工艺美术反机器，现代主义形随功，包豪斯艺术技术统，乌尔姆科学系统化。程序方法基础：战略战术和内功，三者协同创新生。",
   "label": "【速记口诀】设计史四运动",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-040",
   "type": "heading",
   "level": 1,
   "text": "第二章 产品设计程序",
   "label": "",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-041",
   "type": "paragraph",
   "level": 0,
   "text": "【考情分析】本章每年分值16—20分，题型覆盖选择题、填空题、简答题、辨析题。",
   "label": "",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-042",
   "type": "heading",
   "level": 2,
   "text": "核心考点一：双钻模型（★★★★★）",
   "label": "",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-043",
   "type": "list_item",
   "level": 0,
   "text": "四个阶段：",
   "label": "",
   "marker": "1.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-044",
   "type": "kv",
   "level": 0,
   "text": "广泛探索问题空间（用户研究、市场调研、竞品分析）",
   "label": "发现（发散）",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-045",
   "type": "kv",
   "level": 0,
   "text": "聚焦核心问题（用户洞察、设计简报、HMW问题）",
   "label": "定义（收敛）",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-046",
   "type": "kv",
   "level": 0,
   "text": "广泛构思解决方案（头脑风暴、草图、故事板）",
   "label": "开发（发散）",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-047",
   "type": "kv",
   "level": 0,
   "text": "实现并验证最优方案（原型、测试、迭代、生产）",
   "label": "交付（收敛）",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-048",
   "type": "list_item",
   "level": 0,
   "text": "核心隐喻：第一颗钻石——探索正确的问题；第二颗钻石——探索正确的方案",
   "label": "",
   "marker": "2.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-049",
   "type": "list_item",
   "level": 0,
   "text": "思维节奏：发散→收敛→发散→收敛，避免过早决策，拓宽创新空间",
   "label": "",
   "marker": "3.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-050",
   "type": "list_item",
   "level": 0,
   "text": "模型价值：提供共同语言、风险管理、保障创新涌现",
   "label": "",
   "marker": "4.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-051",
   "type": "heading",
   "level": 2,
   "text": "核心考点二：IDEO设计思维模型（★★★★★）",
   "label": "",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-052",
   "type": "list_item",
   "level": 0,
   "text": "五个阶段（非线性、迭代循环）：",
   "label": "",
   "marker": "1.",
   "ordered": true,
   "headers": [],
   "rows": [],
   "depth": 0
  },
  {
   "id": "blk-053",
   "type": "kv",
   "level": 0,
   "text": "深入用户世界，获取深层需求（观察、访谈、沉浸）",
   "label": "共情",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-054",
   "type": "kv",
   "level": 0,
   "text": "提炼观点，转化为设计挑战（HMW问题）",
   "label": "定义",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-055",
   "type": "kv",
   "level": 0,
   "text": "突破性创意生成（头脑风暴、SCAMPER）",
   "label": "构思",
   "marker": "",
   "ordered": false,
   "headers": [],
   "rows": [],
   "depth": 1
  },
  {
   "id": "blk-056",
   "type": "kv",
   "level": 0,
   "text": "快速制作可体验的模型（低保真→中保真→高保真）",
