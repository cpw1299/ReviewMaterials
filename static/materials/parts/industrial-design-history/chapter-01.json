      "marker": "",
      "ordered": false,
      "headers": [
        ""
      ],
      "rows": [
        [
          ""
        ]
      ],
      "depth": 0
    },
    {
      "id": "blk-0007",
      "type": "paragraph",
      "level": 0,
      "text": "审美属性：赋予产品以情感、文化与象征意义",
