    {
      "id": "blk-0004",
      "type": "list_item",
      "level": 0,
      "text": "设计的本质：有目的地解决问题，在约束条件下创造性地满足需求",
      "label": "",
      "marker": "1.",
      "ordered": true,
      "headers": [
        ""
      ],
      "rows": [
        [
          ""
        ]
      ],
      "depth": 0
    },
    {
      "id": "blk-0005",
      "type": "list_item",
      "level": 0,
      "text": "设计的双重属性：",
      "label": "",
      "marker": "2.",
      "ordered": true,
      "headers": [
        ""
      ],
      "rows": [
        [
          ""
        ]
      ],
      "depth": 0
    },
    {
      "id": "blk-0006",
      "type": "paragraph",
      "level": 0,
      "text": "实用属性：满足功能、技术、经济等需求",
