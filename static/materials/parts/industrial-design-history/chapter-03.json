      "marker": "1.",
      "ordered": true,
      "headers": [
        ""
      ],
      "rows": [
        [
          ""
        ]
      ],
      "depth": 0
    },
    {
      "id": "blk-0095",
      "type": "list_item",
      "level": 0,
      "text": "形式来源：工艺美术回归中世纪哥特；新艺术直接效法自然界有机形态",
      "label": "",
      "marker": "2.",
      "ordered": true,
      "headers": [
        ""
