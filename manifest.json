{
	"name": "复习资料",
	"appid": "__UNI__C9CF01A",
	"description": "离线知识点复习阅读器",
	"versionName": "1.0.0",
	"versionCode": 100,
	"uni-app-x": {
		"styleIsolationVersion": "2",
		"vapor-render-target": "bytecode"
	},
	"vueVersion": "3",
	"uniStatistics": {
		"enable": false
	},
	"app": {
		"defaultAppTheme": "auto"
	},
	"app-android": {
		"distribute": {
			"icons": {
				"xxhdpi": "package/icon144.png",
				"xxxhdpi": "package/icon192.png"
			},
			"splashScreens": {
				"default": {}
			},
			"abiFilters": [
				"arm64-v8a"
			],
			"disableLegacyPackaging": true
		}
	},
	"app-ios": {
		"distribute": {
			"icons": {
				"appstore": "package/icon1024.png"
			},
			"splashScreens": {}
		}
	},
	"app-harmony": {
		"distribute": {
			"bundleName": "com.reviewmaterials.app",
			"icons": {
				"foreground": "package/D-1024.png",
				"background": "package/background-white.png"
			},
			"splashScreens": {
				"startWindowIcon": "package/icon256.png"
			},
			"deviceTypes": [
				"phone",
				"tablet"
			],
			"deviceArchs": [
				"arm64-v8a"
			]
		}
	},
	"web": {
		"darkmode": true,
		"router": {
			"mode": ""
		}
	}
}